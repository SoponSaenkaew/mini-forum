APP_NAME="Mini Forum" 
APP_ENV=local 
APP_KEY=
APP_DEBUG=true 
APP_URL=http://localhost 

LOG_CHANNEL=stack 
LOG_LEVEL=debug 

# --- Database (PostgreSQL via Sail) ---
DB_CONNECTION=pgsql 
DB_HOST=pgsql 
DB_PORT=5432 
DB_DATABASE=laravel 
DB_USERNAME=sail
DB_PASSWORD=password

# --- Services Configuration ---
SESSION_DRIVER=database 
SESSION_LIFETIME=120

CACHE_STORE=database 
FILESYSTEM_DISK=local 

# --- Queue System (Crucial for Notifications) ---
# ตั้งเป็น database เพื่อให้ระบบแจ้งเตือนทำงานผ่าน Queue 
QUEUE_CONNECTION=database 

# --- Redis Configuration ---
REDIS_HOST=redis 
REDIS_PASSWORD=null 
REDIS_PORT=6379 

# --- Real-time Notification (Laravel Reverb - For Local) ---
BROADCAST_CONNECTION=reverb 

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="0.0.0.0" 
REVERB_PORT=8081 
REVERB_SCHEME=http

# --- Frontend (Vite & Echo) ---
# ใช้ localhost เพื่อให้ Browser บน Windows คุยกับ Docker ได้
VITE_APP_NAME="${APP_NAME}"
VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}" 

# --- Mail Configuration (Log for Testing) ---
MAIL_MAILER=log 
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# =========================================================================
# ☁️ PRODUCTION CONFIGURATION (ตัวแปรสำหรับตั้งค่าตอน Deploy ขึ้น Cloud)
# =========================================================================

# --- Real-time Notification (Pusher - For Production) ---
# เปลี่ยน BROADCAST_CONNECTION=pusher และกรอกค่าด้านล่าง
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Cloud Storage (Supabase) ---
# เปลี่ยน FILESYSTEM_DISK=supabase และกรอกค่าด้านล่าง
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
